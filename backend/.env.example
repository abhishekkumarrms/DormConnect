# ── Database ────────────────────────────────────────────────────────────────
# Railway PostgreSQL addon provides this automatically
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dormconnect

# ── Redis ────────────────────────────────────────────────────────────────────
# Railway Redis addon provides this automatically
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" on Railway
ENVIRONMENT=development

# Comma-separated allowed CORS origins (production only, leave empty to allow all)
# ALLOWED_ORIGINS=https://myapp.railway.app,https://myapp.com
ALLOWED_ORIGINS=

# ── File Uploads (Cloudinary) ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Push Notifications (Firebase) ────────────────────────────────────────────
# Option 1: file path (local dev)
FCM_CREDENTIALS_PATH=./firebase-credentials.json
# Option 2: base64-encoded JSON (Railway — no file needed)
# Generate: base64 -w 0 firebase-credentials.json
# FCM_CREDENTIALS_JSON=<base64-encoded-json>

# ── SMS (Msg91) ───────────────────────────────────────────────────────────────
SMS_API_KEY=your-msg91-key
SMS_SENDER_ID=DRMCNT
